E5_JWT_SECRET=change-me-to-a-random-64-char-string
E5_LOGIN_KEY=                  # 비워 두면 자동으로 생성되어 시작할 때 출력됩니다.
E5_ENCRYPTION_KEY=             # 비워 두면 암호화하지 않습니다. 설정 후에는 변경할 수 없습니다.
E5_PATH_PREFIX=/your-prefix    # 비워 두면 경로 접두사를 사용하지 않습니다.
# E5_TLS_CERT=/certs/fullchain.pem
# E5_TLS_KEY=/certs/privkey.pem
