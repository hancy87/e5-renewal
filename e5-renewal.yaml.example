# E5 Renewal 설정 예제
# ~/e5-renewal.yaml로 복사한 뒤 수정하세요. 환경 변수가 우선 적용됩니다(.env.example 참고).

server:
  host: ""
  port: 8080
  path_prefix: ""
  # tls_cert: /certs/fullchain.pem
  # tls_key: /certs/privkey.pem

database:
  path: "data/e5.db"

security:
  jwt_secret: "change-me-to-a-random-64-char-string"
  encryption_key: "change-me-to-a-random-string"
  # login_key: ""  # 비워 두면 자동으로 생성됩니다.

scheduler:
  min_hours: 2
  endpoints_min: 3
  endpoints_max: 8
  realistic_timing: false
